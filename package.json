{
  "name": "lumi",
  "private": true,
  "workspaces": [
    "apps/lumi-dashboard",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w packages/lumi-types run build && npm -w apps/lumi-dashboard run dev",
    "build": "npm -w packages/lumi-types run build && npm -w packages/lumi-survey run build && npm -w apps/lumi-dashboard run build",
    "storybook:survey": "npm -w packages/lumi-survey run storybook",
    "build-storybook:survey": "npm -w packages/lumi-survey run build-storybook",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "npm -w packages/lumi-types run typecheck && npm -w packages/lumi-survey run typecheck && npm -w apps/lumi-dashboard run typecheck",
    "verify:lumi-survey": "npm -w @navikt/lumi-survey run build && node scripts/verify-lumi-survey-package.mjs",
    "tanstack:mcp": "node scripts/tanstack-mcp.mjs",
    "test": "npm -w apps/lumi-dashboard run test",
    "e2e": "npm -w apps/lumi-dashboard run e2e",
    "docs:dev": "cd docs && npm run dev",
    "docs:build": "cd docs && npm run build",
    "docs:preview": "cd docs && npm run preview",
    "api:run": "cd apps/lumi-api && ./gradlew run",
    "api:build": "cd apps/lumi-api && ./gradlew build",
    "api:test": "cd apps/lumi-api && ./gradlew test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3"
  },
  "overrides": {
    "@isaacs/brace-expansion": "5.0.1"
  }
}
