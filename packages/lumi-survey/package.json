{
  "name": "@navikt/lumi-survey",
  "version": "2.4.0",
  "private": false,
  "description": "Aksel-based React surveys for Nav, created in Lumi Surveyverksted and connected to Lumi analytics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navikt/lumi.git",
    "directory": "packages/lumi-survey"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/**/*.css"
  ],
  "scripts": {
    "prepack": "pnpm run build",
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.7.0"
  },
  "peerDependencies": {
    "@navikt/ds-css": ">=8",
    "@navikt/ds-react": ">=8",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@navikt/ds-css": "^8.19.2",
    "@navikt/ds-react": "^8.19.2",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "homepage": "https://navikt.github.io/lumi/",
  "bugs": {
    "url": "https://github.com/navikt/lumi/issues"
  },
  "keywords": [
    "nav",
    "lumi",
    "survey",
    "feedback",
    "react",
    "aksel"
  ]
}
