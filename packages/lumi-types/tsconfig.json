{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "rootDir": "src",
    "types": [],
    "lib": ["ES2022"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
