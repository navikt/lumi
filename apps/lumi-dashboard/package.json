{
  "name": "lumi-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node .output/server/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@navikt/aksel-icons": "^8.0.1",
    "@navikt/ds-css": "^8.0.1",
    "@navikt/ds-react": "^8.0.1",
    "@navikt/lumi-types": "0.0.0",
    "@navikt/oasis": "^4.1.1",
    "@navikt/pino-logger": "^4.5.0",
    "@tanstack/react-query": "^5.90.19",
    "@tanstack/react-router": "^1.153.2",
    "@tanstack/react-start": "^1.154.0",
    "@tanstack/zod-adapter": "^1.153.2",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "nitro": "^3.0.1-alpha.2",
    "pino": "^10.2.1",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.4",
    "recharts": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.1",
