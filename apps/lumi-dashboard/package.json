{
  "name": "lumi-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @navikt/lumi-survey run build",
    "dev": "vite dev",
    "prebuild": "pnpm --filter @navikt/lumi-survey run build",
    "build": "vite build && tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node .output/server/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:full-chain": "playwright test --config playwright.full-chain.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grafana/faro-web-sdk": "2.12.1",
    "@nais/apm": "0.6.0",
    "@navikt/aksel-icons": "^8.7.0",
    "@navikt/ds-css": "^8.7.0",
    "@navikt/ds-react": "^8.7.0",
    "@navikt/lumi-survey": "workspace:*",
    "@navikt/lumi-types": "workspace:*",
    "@navikt/oasis": "^4.1.4",
    "@navikt/pino-logger": "^4.5.1",
    "@tanstack/react-query": "^5.96.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/router-core": "^1.171.34",
    "@tanstack/start-storage-context": "^1.167.36",
    "@tanstack/zod-adapter": "^1.167.0",
    "dayjs": "^1.11.20",
    "exceljs": "^4.4.0",
    "nitro": "3.0.1-alpha.2",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.64.1",
    "@tanstack/history": "^1.162.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.3",
    "chokidar": "^5.0.0",
    "jsdom": "^29.0.2",
    "lru-cache": "^11.2.7",
    "pino-pretty": "^13.1.3",
    "seroval": "1.6.9",
    "typescript": "^7.0.2",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.3"
  },
  "engines": {
    "node": "24"
  }
}
