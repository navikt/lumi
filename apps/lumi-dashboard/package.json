    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitejs/plugin-react": "^5.1.2",
    "chokidar": "^5.0.0",
    "jsdom": "^27.4.0",
    "lru-cache": "^11.2.4",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22"
