{
  "name": "lumi-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @navikt/lumi-survey run build",
    "dev": "vite dev",
    "prebuild": "pnpm --filter @navikt/lumi-survey run build",
    "build": "vite build && tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node .output/server/index.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:full-chain": "playwright test --config playwright.full-chain.config.ts",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grafana/faro-web-sdk": "2.12.1",
    "@nais/apm": "0.7.3",
    "@navikt/aksel-icons": "^8.19.2",
    "@navikt/ds-css": "^8.19.2",
    "@navikt/ds-react": "^8.19.2",
    "@navikt/lumi-survey": "workspace:*",
    "@navikt/lumi-types": "workspace:*",
    "@navikt/oasis": "^4.2.2",
    "@navikt/pino-logger": "^5.0.1",
    "@prometheus-io/client": "^0.16.1",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-core": "^1.171.38",
    "@tanstack/zod-adapter": "^1.167.0",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "nitro": "3.0.1-alpha.2",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/history": "^1.162.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "chokidar": "^5.0.0",
    "jsdom": "^30.1.3",
    "lru-cache": "^11.5.3",
    "pino-pretty": "^13.2.0",
    "seroval": "1.6.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "24"
  }
}
