{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/packages/lumi-survey/src/components/questions/rating/EmojiButton.tsx",
        "**/packages/lumi-survey/src/components/questions/rating/NpsRating.tsx",
        "**/packages/lumi-survey/src/components/questions/rating/StarRating.tsx",
        "**/packages/lumi-survey/src/components/questions/rating/ThumbsRating.tsx"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "markdown": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "yaml": {
    "formatter": { "enabled": false },
    "linter": { "enabled": false }
  },
  "files": {
    "includes": [
      "**",
      "!**/apps/lumi-dashboard/app/routeTree.gen.ts",
      "!**/apps/lumi-dashboard/app.config.timestamp_*.js",
      "!**/apps/lumi-dashboard/dist",
      "!**/apps/lumi-dashboard/.output",
      "!**/apps/lumi-dashboard/app/routes/api/backend/$.ts",
      "!**/packages/**/*/dist",
      "!**/storybook-static",
      "!**/apps/lumi-api/build",
      "!**/apps/lumi-api/.gradle"
    ]
  }
}
